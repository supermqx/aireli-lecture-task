":"0","rangeend_line":"0","rangeend_character":"0"},{"codespaceName":"glowing-dollop-j9j675566rpfrx6","eventName":"DocumentChangeEvent","eventTime":1773772415342,"sessionId":"544186ff-9de8-4e32-a172-9c85afaf3dfa1773770497933","machineId":"67e0c3475ad747bd5b5a9d57aa33c83113fdfc0da72403d170eb9c2d40b1f87f","documentUri":"file:///workspaces/aireli-lecture-task/apps/api/src/routes.ts","documentId":20,"operation":"replace","value":"import express from 'express';\nimport { getProducts } from './controllers/products.controllers';\nimport { getCategories } from './controllers/categories.controllers';\nimport { protect } from './middleware/auth.middleware';\nimport { findUserById } from './models/User';\n// Import the new controller\nimport { registerUser } from './controllers/auth.controllers'; \n\nconst router = express.Router();\n\nrouter.get('/products', getProducts);\nrouter.get('/categories', getCategories);\n\n// Add the new register endpoint\nrouter.post('/register', registerUser);\n\n// please disregard the lines below\nrouter.get('/', (req, res) => { return res.json({ message: 'Hello World' }); });\nrouter.get('/me', protect, async (req, res) => { const user = await findUserById(req.body.user); if (user) { res.json({ user }); } else { res.status(404).json({ message: 'User not found' }); }});\n\nexport default router;","rangeOffset":"0","rangeLength":"727","rangestart_line":"0","rangestart_character":"0","rangeend_line":"15","rangeend_character":"22"},{"codespaceName":"glowing-dollop-j9j675566rpfrx6","eventName":"DocumentSaveEvent","eventTime":1773772416463,"sessionId":"544186ff-9de8-4e32-a172-9c85afaf3dfa1773770497933","machineId":"67e0c3475ad747bd5b5a9d57aa33c83113fdfc0da72403d170eb9c2d40b1f87f","documentUri":"file:///workspaces/aireli-lecture-task/apps/api/src/routes.ts","documentId":20,"operation":"save","rangeOffset":"0","rangeLength":"0","rangestart_line":"0","rangestart_character":"0","rangeend_line":"0","rangeend_character":"0"},{"codespaceName":"glowing-doll