b1f87f","documentUri":"","documentId":0,"operation":"windowBlurred","rangeOffset":"0","rangeLength":"0","rangestart_line":"0","rangestart_character":"0","rangeend_line":"0","rangeend_character":"0"},{"codespaceName":"glowing-dollop-j9j675566rpfrx6","eventName":"WindowStateChangeEvent","eventTime":1773771720649,"sessionId":"544186ff-9de8-4e32-a172-9c85afaf3dfa1773770497933","machineId":"67e0c3475ad747bd5b5a9d57aa33c83113fdfc0da72403d170eb9c2d40b1f87f","documentUri":"","documentId":0,"operation":"windowFocused","rangeOffset":"0","rangeLength":"0","rangestart_line":"0","rangestart_character":"0","rangeend_line":"0","rangeend_character":"0"},{"codespaceName":"glowing-dollop-j9j675566rpfrx6","eventName":"ActiveEditorChangeEvent","eventTime":1773771722524,"sessionId":"544186ff-9de8-4e32-a172-9c85afaf3dfa1773770497933","machineId":"67e0c3475ad747bd5b5a9d57aa33c83113fdfc0da72403d170eb9c2d40b1f87f","documentUri":"file:///workspaces/aireli-lecture-task/apps/api/src/models/User.ts","documentId":11,"operation":"focus","rangeOffset":"0","rangeLength":"0","rangestart_line":"0","rangestart_character":"0","rangeend_line":"0","rangeend_character":"0"},{"codespaceName":"glowing-dollop-j9j675566rpfrx6","eventName":"DocumentChangeEvent","eventTime":1773771723865,"sessionId":"544186ff-9de8-4e32-a172-9c85afaf3dfa1773770497933","machineId":"67e0c3475ad747bd5b5a9d57aa33c83113fdfc0da72403d170eb9c2d40b1f87f","documentUri":"file:///workspaces/aireli-lecture-task/apps/api/src/models/User.ts","documentId":11,"operation":"replace","value":"export const createUser = async (userData: any): Promise<PlatformUser | null> => {\n  const db = await openDb();\n  \n  try {\n    // 1. Hash the password before storing it in the database\n    const hashedPassword = await bcrypt.hash(userData.password, 10);\n    \n    // 2. Insert the new user into the database\n    // The 'id', 'createdAt', and 'updatedAt' are handled automatically by SQLite\n    const result = await db.run(\n      `INSERT INTO users (email, password, firstName, lastName, acceptsMarketing, displayName, phone) \n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n      [\n        userData.email,\n        hashedPassword,\n        userData.firstName || null,\n        userData.lastName || null,\n        userData.acceptsMarketing || false,\n        userData.displayName || null,\n        userData.phone || null\n      ]\n    );\n    \n    // 3. Retrieve and return the newly created user using the auto-generated ID\n    const newUser = await db.get<PlatformUser>('SELECT * FROM users WHERE id = ?', result.lastID);\n    \n    await db.close();\n    return newUser || null;\n    \n  } catch (error) {\n    await db.close();\n    console.error('Error creating user:', error);\n    throw error; // Let the controller handle the error (e.g., if email already exists)\n  }\n};","rangeOffset":"0","rangeLength":"1447","rangestart_line":"0","rangestart_character":"0","rangeend_line":"35","rangeend_character":"0"},{"codespaceName":"glowing-dollop-j9j675566rpfrx6","eventName":"DocumentSaveEvent","eventTime":1773771724996,"sessionId":"544186ff-9de8-4e32-a172-9c85afaf3dfa1773770497933","machineId":"67e0c3475ad747bd5b5a9d57aa33c83113fdfc0da72403d170eb9c2d40b1f87f","documentUri":"file:///workspaces/aireli-lecture-task/apps/api/src/models/User.ts","documentId":11,"operation":"save","rangeOffset":"0","rangeLength":"0","rangestart_line":"0","rangestart_character":"0","rangeend_line":"0","rangeend_character":"0"},{"codespaceName":"glowing-dollop-j9j675566rpfrx6","eventName":"WindowStateChangeEvent","eventTime":1773771728920,"sessionId":"544186ff-9de8-4e32-a172-9c85afaf3dfa1773770497933","machineId":"67e0c3475ad747bd5b5a9d57aa33c83113fdfc0da72403d170eb9c2d40b1f87f","documentUri":"","documentId":0,"operation":"windowBlurred","rangeOffset":"0","rangeLength":"0","rangestart_line":"0","rangestart_character":"0","rangeend_line":"0","rangeend_character":"0"},{"codespaceName":"glowing-dollop-j9j675566rpfrx6","eventName":"WindowStateChangeEvent","eventTime